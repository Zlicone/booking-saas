{
  "name": "booking-saas",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "migrate": "npm run migrate --workspace=apps/api"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
